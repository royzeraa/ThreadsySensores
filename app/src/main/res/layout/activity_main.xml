<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Threads y Sensores"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Sección de Hilos (Operación en segundo plano) -->
    <Button
        android:id="@+id/btnIniciarThread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simular Tarea en Segundo Plano" />

    <TextView
        android:id="@+id/tvEstadoThread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: En espera"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="32dp" />

    <!-- Sección de Sensores -->
    <TextView
        android:id="@+id/tvTituloSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Datos del Sensor de Rotación"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDatosSensor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Esperando lectura del sensor..."
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>